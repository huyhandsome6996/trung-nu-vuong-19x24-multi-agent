    "lines": [
      {
        "text": "Tại ngã ba sông Hát Môn, nghĩa quân đắp đàn tế cao hơn hai",
        "baseline_y": 113.01
      },
      {
        "text": "trượng dựa lưng vào núi Ba Vì. Chín mươi chín lá cờ ngũ sắc",
        "baseline_y": 142.01
      },
      {
        "text": "tung bay, 8 thớt voi trắng, 500 kỵ mã, hơn 100 chiến thuyền dàn",
        "baseline_y": 171.01
      },
      {
        "text": "trận uy nghiêm. Trong tiếng chiêng trống vang trời, Trưng Trắc",
        "baseline_y": 200.01
      },
      {
        "text": "và Trưng Nhị thành kính dâng hương tế cáo trời đất và tổ tiên.",
